{
    "author": "Pouya Kary",
    "description": "RegEx done right",
    "homepage": "http://orchestra.kary.us",
    "license": "Apache-2.0",
    "main": "winserver/main.js",
    "name": "orchestra",
    "productName": "Orchestra",
    "version": "1.0.0",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --mac",
        "build:linux": "electron-builder --linux",
        "build:win": "electron-builder --win",
        "pack": "electron-builder --dir",
        "dist": "electron-builder"
    },
    "build": {
        "appId": "us.kary.orchestra",
        "productName": "Orchestra",
        "directories": {
            "output": "_release"
        },
        "files": [
            "winserver/**/*",
            "editor/**/*",
            "view/**/*",
            "libs/**/*",
            "windows/**/*",
            "resources/**/*",
            "sheets/**/*",
            "!node_modules/**/{test,__tests__,tests,powered-test,example,examples}",
            "!node_modules/**/*.{md,ts,map}"
        ],
        "extraResources": [],
        "mac": {
            "category": "public.app-category.developer-tools",
            "icon": "designs/icon/icns/icon.icns",
            "target": [
                "dmg",
                "zip"
            ],
            "hardenedRuntime": true,
            "extendInfo": {
                "CFBundleDocumentTypes": [
                    {
                        "CFBundleTypeName": "Orchestra Source File",
                        "CFBundleTypeRole": "Editor",
                        "CFBundleTypeExtensions": ["orchestra"]
                    }
                ],
                "CFBundleURLTypes": [
                    {
                        "CFBundleTypeRole": "Viewer",
                        "CFBundleURLName": "Orchestra",
                        "CFBundleURLSchemes": ["orchestra"]
                    }
                ]
            }
        },
        "dmg": {
            "background": "build/dmg-back.png",
            "iconSize": 152
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Development"
        },
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "designs/icon/icon.ico"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/pmkary/orchestra"
    },
    "dependencies": {
        "concerto-compiler": "1.0.5",
        "core-js": "^3.4.7",
        "jsonfile": "^2.4.0",
        "lodash.template": "^4.5.0",
        "monaco-editor": "^0.52.0",
        "regenerate-unicode-properties": "^8.1.0",
        "regexpu": "^4.1.1",
        "regulex": "0.0.2"
    },
    "devDependencies": {
        "electron": "^39.8.5",
        "electron-builder": "^26.15.3",
        "less": "^4.2.0",
        "yargs": "^17.1.1"
    }
}
